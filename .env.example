# ─────────────────────────────────────────────
# Zehni Sukoon — Environment Configuration TEMPLATE
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit `.env` — it is gitignored. Only this template is tracked.
# ─────────────────────────────────────────────

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# JWT (signs login + password-reset tokens)
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_EXPIRES_HOURS=24

# Database
# Local dev can use SQLite; production should use Postgres.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=sqlite:///zehni_test.db

# Postgres credentials used by docker-compose.yml.
# Compose reads these from this (git-ignored) .env — never commit real values.
POSTGRES_USER=zehni_user
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_DB=zehni_sukoon

# CORS — comma-separated origins (no spaces)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Guest session expiry (hours)
GUEST_SESSION_EXPIRY_HOURS=24

# ── LLM providers (multi-provider failover, OpenAI-compatible) ──────────
# LLM_PROVIDERS is the failover order. Providers with no API key are skipped,
# so you only need keys for the providers you actually have. On a 429 the
# next provider is tried immediately; timeouts/5xx get one quick retry.
LLM_PROVIDERS=qwen,groq,gemini

# Qwen (Alibaba DashScope international, OpenAI-compatible)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
# How long Groq thinks before answering: low | medium | high.
# Any other value (e.g. off) omits the field entirely.
# Default when unset: low (fast replies; reasoning tokens count against
# LLM_MAX_TOKENS, so high effort can starve the JSON reply budget).
GROQ_REASONING_EFFORT=low

# Google Gemini (OpenAI-compatible; GEMINI_API_KEY also enables the legacy
# single-provider path, so an existing .env keeps working unchanged)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Set GEMINI_MODEL to a model that is CURRENTLY listed as available in
# Google AI Studio (https://aistudio.google.com/models). Google rotates model
# IDs regularly - a stale hardcoded ID returns 400/404 from the API.
GEMINI_MODEL=your-currently-available-gemini-model-id

# LLM speed / budget tuning (all optional)
LLM_TIMEOUT_SECONDS=18
LLM_MAX_TOKENS=700
# Recent transcript messages sent verbatim; earlier turns are represented by
# the server's compact scored-items record (server-side guards still see all)
LLM_RECENT_TURNS=6

# Conversational screening: daily chat-turn caps per identity
# (a crisis message always bypasses the cap)
CHAT_TURNS_PER_USER_DAY=80
CHAT_TURNS_PER_GUEST_DAY=40

# ── Password reset (optional email delivery) ──
# If SMTP_HOST is left blank, reset links are logged to the server instead of
# emailed, so the app still deploys and runs with no extra secrets configured.
PASSWORD_RESET_EXPIRY_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
