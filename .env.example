# ─────────────────────────────────────────────
# Zehni Sukoon — Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# JWT
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_EXPIRES_HOURS=24

# Database — ApsaraDB / Postgres
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://zehni_user:changeme@localhost:5432/zehni_sukoon

# CORS — comma-separated origins (no spaces)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Guest session expiry (hours)
GUEST_SESSION_EXPIRY_HOURS=24

# Qwen / DashScope (Alibaba Cloud Model Studio)
# Used for Companion chat and PHQ-9/GAD-7 score extraction
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
